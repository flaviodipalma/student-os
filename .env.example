# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---- Supabase: database + login ----------------------------------------------
# From your Supabase project: Project Settings > API (or the "Connect" button).
# These two are public by design (the NEXT_PUBLIC_ prefix sends them to the browser);
# every table has Row Level Security on, so they can't read Student OS data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string, SERVER-ONLY (no NEXT_PUBLIC_ prefix). Use the
# connection pooler URI ("Transaction" mode, port 6543) from Connect > ORMs/Drizzle,
# with your database password filled in.
DATABASE_URL=

# ---- AI: syllabus import -----------------------------------------------------
# Claude API key, server-only. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model reads syllabi (default: claude-opus-5).
# Options: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# SYLLABUS_AI_MODEL=claude-opus-5

# Optional: "mock" swaps the AI for a simple local pattern matcher, for
# development without an API key. It is NOT real AI; don't use it for real syllabi.
# SYLLABUS_AI_PROVIDER=anthropic

# ---- Development seed (optional) ----------------------------------------------
# `npm run db:seed` fills this ONE account with sample courses, tasks and events.
# Use an address you control; real accounts are never touched.
# DEV_SEED_EMAIL=
# DEV_SEED_PASSWORD=
