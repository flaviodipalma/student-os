# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---- Environment ---------------------------------------------------------------
# "production" on the real deployment only: the server then refuses to start
# with an unsafe or incomplete configuration (HTTPS, no localhost redirects, no
# mock AI). Leave unset for development, including `npm start` on your laptop.
# Check any time with: npm run check:env   (APP_ENV=production npm run check:env)
# APP_ENV=production

# ---- Supabase: database + login ----------------------------------------------
# From your Supabase project: Project Settings > API (or the "Connect" button).
# These two are public by design (the NEXT_PUBLIC_ prefix sends them to the browser);
# every table has Row Level Security on, so they can't read Student OS data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string, SERVER-ONLY (no NEXT_PUBLIC_ prefix). Use the
# connection pooler URI ("Transaction" mode, port 6543) from Connect > ORMs/Drizzle,
# with your database password filled in.
DATABASE_URL=

# ---- Login with Google, Microsoft and Apple -----------------------------------
# Supabase Auth runs these sign-ins, so their client ids and secrets go in the
# SUPABASE DASHBOARD (Authentication > Sign In / Providers), NOT in this file.
# Nothing provider-specific is needed here. Step-by-step: docs/authentication.md
#   Google:    OAuth client ID + secret (Google Cloud Console > Credentials)
#   Microsoft: Application (client) ID + client secret (Microsoft Entra admin
#              center > App registrations); Azure Tenant URL left empty or
#              https://login.microsoftonline.com/common (personal + school accounts)
#   Apple:     Services ID (client id) + a client secret generated from your
#              Sign in with Apple key (.p8), Team ID and Key ID
#
# Optional, SERVER-ONLY: the app's public address, used for the sign-in
# callback (<SITE_URL>/auth/callback). Set it in production; without it the
# request's own address is used (fine for localhost). No trailing slash.
# SITE_URL=https://studentos.example.com

# ---- AI: syllabus import -----------------------------------------------------
# Claude API key, server-only. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model reads syllabi (default: claude-opus-5).
# Options: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# SYLLABUS_AI_MODEL=claude-opus-5

# Optional: "mock" swaps the AI for a simple local pattern matcher, for
# development without an API key. It is NOT real AI; don't use it for real syllabi.
# SYLLABUS_AI_PROVIDER=anthropic

# ---- AI: Student Assistant -----------------------------------------------------
# Optional. Default: the same provider/model as the syllabus import.
# ASSISTANT_AI_PROVIDER=anthropic
# ASSISTANT_AI_MODEL=claude-opus-5

# ---- Canvas and Blackboard: the browser extension ------------------------------
# Canvas and Blackboard connect only through the Student OS browser extension
# (extension/README.md), with each student's own login: no school app, keys or
# secrets. SERVER-ONLY: the Chrome extension ids allowed to use a student's
# Student OS login (comma-separated). Set it to the published extension's id in
# production; empty allows any extension (development, where an unpacked
# extension's id varies).
# STUDENT_OS_EXTENSION_IDS=

# Key that encrypts stored Google Calendar and Outlook tokens (AES-256-GCM): 32
# random bytes, base64. Generate with:  openssl rand -base64 32
# Keep it in your host's secret settings; changing it means students reconnect
# their calendars. (Its name is historical: it's no longer used for Canvas or Blackboard.)
# LMS_TOKEN_ENCRYPTION_KEY=

# ---- Personal calendars: Google Calendar and Outlook ----------------------------
# All SERVER-ONLY (never NEXT_PUBLIC_). Separate from login: these are the apps
# students approve when they click Connect on the Integrations page (Calendars).
# They also need LMS_TOKEN_ENCRYPTION_KEY (above), which encrypts their tokens.
# Setup guide: docs/calendar-integrations.md
#
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Enable the Google Calendar API. Scopes: calendar.calendarlist.readonly and
# calendar.events.readonly. The redirect URI must match the client's exactly.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
#
# Microsoft Entra admin center > App registrations (any organizational directory
# + personal Microsoft accounts). Microsoft Graph delegated permissions:
# Calendars.Read and offline_access. Client secret = the secret's VALUE.
# OUTLOOK_CALENDAR_CLIENT_ID=
# OUTLOOK_CALENDAR_CLIENT_SECRET=
# OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/outlook-calendar/callback
# Optional: "common" (default: personal + school/work accounts), or one tenant id.
# OUTLOOK_CALENDAR_TENANT=common

# ---- Development seed (optional) ----------------------------------------------
# `npm run db:seed` fills this ONE account with sample courses, tasks and events.
# Use an address you control; real accounts are never touched.
# DEV_SEED_EMAIL=
# DEV_SEED_PASSWORD=
